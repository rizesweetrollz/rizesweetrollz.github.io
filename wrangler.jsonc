{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rizesweetrollz-github-io",
  // Bump this occasionally to a recent date — it pins which version
  // of the Workers runtime behavior this project gets. Today's date
  // is always a safe value.
  "compatibility_date": "2026-09-23",
  "main": "./worker.js",

  "assets": {
    // All public site files (index.html, css/, js/, images/,
    // data/*.json) live under public/ — kept separate from
    // wrangler.jsonc, worker.js, and functions/ on purpose, so the
    // asset directory never contains Wrangler's own working files.
    "directory": "./public",
    "binding": "ASSETS",
    // ONLY these paths run worker.js. Every other request is served
    // as a plain static file directly, without touching worker.js
    // at all — fastest possible path, and matches how this site
    // worked before checkout needed a server.
    "run_worker_first": ["/create-checkout"]
  },

  "vars": {
    "SQUARE_ENV": "production"
  },
  "secrets": {
    "required": ["SQUARE_ACCESS_TOKEN", "SQUARE_LOCATION_ID"]
  }
}
